# External API keys
# IMPORTANT: Get free Finnhub API key at https://finnhub.io (real-time data, no 15-min delay!)
FINNHUB_API_KEY=your_finnhub_api_key_here
ALPHA_VANTAGE_API_KEY=
POLYGON_API_KEY=
FRED_API_KEY=

# Infrastructure
REDIS_URL=redis://localhost:6379
DATABASE_URL=sqlite+aiosqlite:///./saham_us.db

# App
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
CACHE_TTL_QUOTE=60
CACHE_TTL_HISTORY=300
CACHE_TTL_FUNDAMENTALS=86400

# Authentication (CHANGE IN PRODUCTION!)
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Security
RATE_LIMIT_PER_MINUTE=60

# Monitoring (optional)
SENTRY_DSN=
